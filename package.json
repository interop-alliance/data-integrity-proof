{
  "name": "@interop/data-integrity-proof",
  "version": "3.4.1",
  "description": "Data Integrity Proof library for use with jsonld-signatures.",
  "type": "module",
  "scripts": {
    "build": "pnpm run clear && tsc",
    "clear": "rimraf dist/*",
    "dev": "vite",
    "fix": "eslint --fix src test && pnpm run format",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.md\"",
    "lint": "eslint src test",
    "prepare": "pnpm run build",
    "rebuild": "pnpm run clear && pnpm run build",
    "test": "pnpm run fix && npm run lint && pnpm run test-node && pnpm run test-browser",
    "test-browser": "playwright test",
    "test-node": "vitest run",
    "test-coverage": "vitest run --coverage"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "module": "dist/index.js",
  "browser": {
    "crypto": false,
    "./dist/sha256digest.js": "./dist/sha256digest-browser.js",
    "./dist/sha256digest-reactnative.js": false
  },
  "react-native": {
    "crypto": false,
    "./dist/sha256digest.js": "./dist/sha256digest-reactnative.js",
    "./dist/sha256digest-browser.js": false
  },
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@interop/data-integrity-core": "^8.3.0",
    "@interop/jsonld-signatures": "^11.8.3",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0"
  },
  "devDependencies": {
    "@digitalbazaar/data-integrity-context": "^2.0.1",
    "@digitalbazaar/multikey-context": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@interop/ed25519-signature": "^7.1.3",
    "@interop/ed25519-verification-key": "^8.0.3",
    "@interop/security-document-loader": "^9.4.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "data integrity",
    "linked data",
    "jsonld",
    "jsonld-signatures",
    "verifiable credentials"
  ],
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0"
  },
  "author": {
    "name": "Interop Alliance",
    "url": "https://github.com/interop-alliance/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interop-alliance/data-integrity-proof.git"
  },
  "homepage": "https://github.com/interop-alliance/data-integrity-proof",
  "bugs": "https://github.com/interop-alliance/data-integrity-proof/issues"
}
